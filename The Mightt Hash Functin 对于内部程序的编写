# False
# 因为属性不同

print(hash(robot) == hash(robot2))
# 输出说明：
# True
# 因为属性相同，__key() 相同，hash 也相同

print(hash(robot) == hash(robot3))
# 输出说明：
# 很可能 False（不同属性一般 hash 不同，但不绝对保证不冲突）

d = {robot: "value"}
print(d[robot2])
# 输出说明：
# value
# 虽然用的是 robot2 去取值，但 robot == robot2 且 hash 相同
# 所以字典认为它们是同一个 key

