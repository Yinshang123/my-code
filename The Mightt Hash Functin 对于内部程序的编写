# =========================================================
# Robot 类：整合 hash / eq / len / str / repr / add / gt / ge
# =========================================================


class Robot:
    def __init__(self, name, age, address):
        self.name = name
        self.age = age
        self.address = address

    # -----------------------------------------------------
    # 1. 哈希相关：让对象可以当字典的 key / 放进 set
    # -----------------------------------------------------

    def __key(self):
        # 内部方法：返回关键属性元组，供 __hash__ 和 __eq__ 使用
        return (self.name, self.age, self.address)

    def __hash__(self):
        # 用法：hash(robot)、{robot: "value"}、set([robot])
        # 属性相同的两个 Robot，hash 也相同
        return hash(self.__key())

    def __eq__(self, other):
        # 用法：robot1 == robot2
        # 属性相同就视为相等
        if isinstance(other, Robot):
            return self.__key() == other.__key()
        return NotImplemented

    # -----------------------------------------------------
    # 2. 字符串显示：str() / print() / repr()
    # -----------------------------------------------------

    def __str__(self):
        # 用法：print(robot)、str(robot)
        # 给人看的可读格式
        return f"{self.name} is now {self.age} years old, living in {self.address}"

    def __repr__(self):
        # 用法：repr(robot)、交互式环境直接输入 robot
        # 给开发者看的格式，理想情况下能重建对象
        return f"Robot(name={self.name!r}, age={self.age!r}, address={self.address!r})"

    # -----------------------------------------------------
    # 3. 长度：len()
    # -----------------------------------------------------

    def __len__(self):
        # 用法：len(robot)
        # 这里把 age 当作“长度”，必须返回非负整数
        return self.age

    # -----------------------------------------------------
    # 4. 运算符：+、>、>=
    # -----------------------------------------------------

    def __add__(self, other):
        # 用法：robot1 + robot2
        # 两个 Robot 相加，返回年龄之和
        if isinstance(other, Robot):
            return self.age + other.age
        return NotImplemented

    def __gt__(self, other):
        # 用法：robot1 > robot2
        # 按年龄比较
        if isinstance(other, Robot):
            return self.age > other.age
        return NotImplemented

    def __ge__(self, other):
        # 用法：robot1 >= robot2
        # 按年龄比较
        if isinstance(other, Robot):
            return self.age >= other.age
        return NotImplemented


# =========================================================
# 使用演示
# =========================================================

r1 = Robot("wilson", 27, "taiwan")
r2 = Robot("alice", 30, "beijing")
r3 = Robot("wilson", 27, "taiwan")   # 和 r1 属性完全相同

# ---- hash / eq ----
print("hash(r1) == hash(r3):", hash(r1) == hash(r3))   # True
print("r1 == r3:", r1 == r3)                            # True
print("r1 == r2:", r1 == r2)                            # False

d = {r1: "admin"}
# admin，因为 r1 == r3 且 hash 相同
print("d[r3]:", d[r3])

unique = set([r1, r2, r3])
print("len(unique):", len(unique))                      # 2，r1 和 r3 被视为同一个

# ---- str / repr ----
print("str(r1):", str(r1))
print("repr(r1):", repr(r1))
print("直接 print(r1):")
print(r1)

# ---- len ----
print("len(r1):", len(r1))                              # 27

# ---- + ----
print("r1 + r2:", r1 + r2)                              # 57

# ---- > 和 >= ----
print("r2 > r1:", r2 > r1)                              # True
print("r2 >= r1:", r2 >= r1)                            # True
print("r1 >= r3:", r1 >= r3)                            # True
