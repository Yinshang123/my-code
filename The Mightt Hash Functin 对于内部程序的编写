class Robot:
    def __init__(self, name, age, address):
        self.name = name
        self.age = age
        self.address = address
        # define a private method __key()

    def __key(self):
        # 返回一个由关键属性组成的元组
        # 元组是可哈希的（前提是元素都可哈希），所以可以用来算 hash
        return (self.name, self.age, self.address)

    # implement __hash__() function
    def __hash__(self):
        # 用关键属性的 hash 作为整个对象的 hash
        # 这样：属性相同的两个 Robot 实例，hash 也相同
        return hash(self.__key())

    # implement __eq__() function
    def __eq__(self, other):
        # isinstance(other, Robot)：判断 other 是不是 Robot 的实例
        if isinstance(other, Robot):
            # 属性元组相同，就认为两个对象相等
            return self.__key() == other.__key()
        # NotImplemented 不是异常，是一个特殊值
        # 表示“我不知道怎么比较，让 Python 去试试对方的 __eq__ 或回退默认行为”
        return NotImplemented


robot = Robot("wilson", 27, "taiwan")
dictionary = {robot: "wilson"}
print(dictionary[robot])
# 输出说明：
# wilson
# 因为 robot 是可哈希的，可以作为字典的 key


