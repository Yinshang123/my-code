# ============================================
# 题目 2：safe_hash
# 要求：写一个函数 safe_hash(obj)
#  - 如果对象可 hash，返回它的 hash 值
#  - 如果对象不可 hash（如 list、dict），返回 "unhashable"
# 提示：用 try/except 捕获 TypeError
# ============================================


def safe_hash(obj):
    try:
        return hash(obj)
    except TypeError:
        return "unhashable"


# ---- 测试代码（不要改）----
if __name__ == "__main__":
    print(safe_hash(100))          # 期望：某个整数
    print(safe_hash("hello"))      # 期望：某个整数
    print(safe_hash((1, 2, 3)))    # 期望：某个整数
    print(safe_hash([1, 2, 3]))    # 期望：unhashable
    print(safe_hash({"a": 1}))     # 期望：unhashable


