# 题目 1：hash 函数
# 要求：运行后观察输出，思考下面问题：
#  1. hash(100) 和 hash(1.0) 一样吗？
# 不一样，100为整数，1.0为浮点数
#  2. hash(True) 和 hash(1) 一样吗？
# 一样的，python中True为1，False为0
#  3. hash(None) 能运行吗？
# 能运行
#  4. 字符串的 hash 每次运行都一样吗？（多跑几次）
# 不一样，给字符的哈希加了随机，每次结果不一样
# ============================================

a = 100
b = "This is just a string"
c = True
d = 1.0
e = None

print("hash(a) =", hash(a))  # int，整数，像100，-3，能被哈希
print("hash(b) =", hash(b))  # str，字符串，像"hello""world"能被哈希
print("hash(c) =", hash(c))  # bool，布尔值，True和False能被哈希
print("hash(d) =", hash(d))  # float，浮点数，像1.0，-3.14能被哈希
print("hash(e) =", hash(e))  # None，空值，能被哈希

# 额外观察：
print("hash(100) == hash(1.0)?", hash(100)
      == hash(1.0))  # 不是同一物，100为整数，1.0为浮点数
print("hash(True) == hash(1)?", hash(True) == hash(1))  # 同一物，因为在python中True为1

