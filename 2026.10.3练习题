# ============================================
# 题目 5：divide 函数 + 自定义异常
# 要求：
#  - 自定义异常 DivisionByZeroError
#  - divide(a, b) 用 EAFP 风格
#  - b == 0 时抛 DivisionByZeroError
#  - b < 0 时抛 ValueError
#  - 正常返回 a / b
#  - 在测试代码里捕获并打印友好信息
# ============================================

class DivisionByZeroError(Exception):
    """除零自定义异常"""


def divide(a, b):
    """用 EAFP 风格实现除法，b 为 0 抛自定义异常，b 为负抛 ValueError"""
    if b == 0:
        raise DivisionByZeroError("除数不为0")
    if b < 0:
        raise ValueError("除数不为负数")
    return a/b


# ---- 测试代码（不要改）----
if __name__ == "__main__":
    test_cases = [(10, 2), (10, 0), (10, -1)]

    for a, b in test_cases:
        try:
            result = divide(a, b)
            print(f"divide({a}, {b}) = {result}")
        except DivisionByZeroError as e:
            print(f"divide({a}, {b}) 出错: 除数不能为 0 ({e})")
        except ValueError as e:
            print(f"divide({a}, {b}) 出错: 除数不能为负数 ({e})")
        except Exception as e:
            print(f"divide({a}, {b}) 未知错误: {e}")


