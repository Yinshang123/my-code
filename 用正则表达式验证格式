

import re
regex = r"\b[A-Za-z0-9./%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,5}\b"
regex1 = r"[^@]+@[^@]+\.[^@]+"


def check_email(email):
    if re.fullmatch(regex, regex1):
        print(f"{email} is a vaild email!!!")
    else:
        print(f"{email} is not valid.")


