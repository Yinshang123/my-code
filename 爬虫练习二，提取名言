import requests
from bs4 import BeautifulSoup

url = "https://quotes.toscrape.com/"
response = requests.get(url)
soup = BeautifulSoup(response.text, "lxml")
# Find all quotes on the page
quotes = soup.find_all("div", class_="quote")
print(f"found {len(quotes)} quotes on the page")
# 得到了找到十页
for q in quotes:
    # Exctract the text of the quote
    text_tag = q.find("span", class_="text")
    # Extrect the author of the quote
    author_tag = q.find("small", class_="author")
    # Extract the tags of the quote
    tags_div = q.find("div", class_="tags")
    # 在tags-div中找到所有的a标签
    tag_list = tags_div.find_all("a", class_="tag")
    # 把标签都成一句话
    tags_text = [tag.get_text() for tag in tag_list]
    print(f"Quote: {text_tag.get_text()}")
    print(f"Author: {author_tag.get_text()}")
    print(f"Tags: {tags_text}")
    print("-"*30)
