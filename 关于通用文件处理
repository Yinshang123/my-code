import os
import sys
import io
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
# os Modules 一种在各种程序中都能用的语法
# window uses NTFS
# macos uses APFS
# Linux uses ext4


# os.getcwd()目前正在工作的资料
print(os.getcwd())

# os.listdir(path="")展示现在有的文件夹
print(os.listdir())

# os.curdir 同上的结果
print(os.listdir(os.curdir))

# os.pardir 展示桌面上有的东西
print(os.pardir)
print(os.listdir(os.pardir))

