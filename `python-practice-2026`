# ==================== 题 4（统计：及格人数+平均分+最高分对象） ====================
# 给定：
students = [
    {"name": "Alice", "score": 85, "city": "Beijing"},
    {"name": "Bob", "score": 59, "city": "Shanghai"},
    {"name": "Charlie", "score": 85, "city": "Beijing"},
    {"name": "David", "score": 92, "city": "Guangzhou"},
]

# 要求：
# 1) 及格（>=60）人数
# 2) 平均分（两位小数）
# 3) 最高分学生的 name（如并列，返回任意一个即可）
pass_students = sum(1 for s in students if s["score"] >= 60)
ave = round(sum(s["score"] for s in students) / len(students), 2)


def get_score(s):
    return s["score"]


best_student = max(students, key=get_score)
best_name = best_student["name"]
print(f"the pass number:{pass_students}")
print(f"average score:{ave}")
print(f"best scort:{best_name}")
# 【要点映射】
# 1. sum(1 for s in students if s["score"] >= 60) → 计数
# 2. sum(s["score"] for s in students) / len(students) → 平均分
# 3. round(平均分, 2) → 保留两位小数
# 4. max(students, key=lambda s: s["score"]) → 找最高分对象
# 5. 最高分对象的 name → max_obj["name"]

