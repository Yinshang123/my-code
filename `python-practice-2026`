# ==================== 题 6（综合：TopK + 去重 + 统计） ====================
# 给定：
scores = [90, 80, 90, 70, 60, 80, 100, 100, 50]

# 要求：
# 1) 去重后从高到低排序
# 2) 取 Top3
# 3) 统计 >=80 的人数
scores1 = sorted(set(scores), reverse=True)
scores2 = scores1[:3]
number = sum(1 for s in scores if s >= 80)
print(f"score's list:{scores1}")
print(f"top3:{scores2}")
print(f"the score more 80:{number}")
# 【要点映射】
# 1. set(scores) → 去重
# 2. sorted(集合, reverse=True) → 从高到低排序
# 3. 结果[:3] → 取 Top3
# 4. sum(1 for s in scores if s >= 80) → 统计 >=80 的人数

