# ==================== 题 3（集合运算：交并差） ====================
# 给定：
a = ["py", "js", "go", "py"]
b = ["java", "py", "rust"]

# 要求：分别求：交集、并集、a 独有（差集）。
a1 = set(a)
b1 = set(b)
ab1 = a1 & b1
ab2 = a1 | b1
ab3 = a1 - b1
print(list(ab1))
print(list(ab2))
print(list(ab3))
# 【要点映射】
# 1. set(a) → 转集合
# 2. set_a & set_b → 交集
# 3. set_a | set_b → 并集
# 4. set_a - set_b → a 独有（差集）
# 5. 结果可能需要 list() 转回列表

