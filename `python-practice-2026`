# ==================== 题 2（集合去重：保序去重） ====================
# 给定：
nums = [3, 1, 3, 2, 1, 5, 2, 6, 6]

# 要求：输出"保留第一次出现顺序"的去重列表。
seen = set()
out = []
for i in nums:
    if i not in seen:
        out.append(i)
        seen.add(i)
print(out)
# 【要点映射】
# 1. seen = set() → 用于记录已出现的元素
# 2. out = [] → 用于存储结果（保持顺序）
# 3. for x in nums: 遍历每个元素
# 4. if x not in seen: 判断是否第一次出现
# 5. out.append(x); seen.add(x) → 添加到结果并记录

