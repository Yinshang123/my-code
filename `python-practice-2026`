# ==================== 题 1（推导式：筛选+转换） ====================
# 给定：
from collections import Counter
words = ["  Apple", "banana ", "Cherry", "avocado", ""]

# 要求：得到新列表，包含去掉首尾空格后、非空、且首字母是 a/A 的单词，并全部变小写。
result = [
    w.strip().lower()
    for w in words
    if w.strip()
    and w.strip().lower().startswith("a")
]
print(result)
# 【要点映射】
# 1. strip() → 去首尾空格，用在元素上：x.strip()
# 2. 非空 → 判断条件：x.strip() != ""  或  x.strip()
# 3. 首字母是 a/A → x.strip().lower().startswith('a')
# 4. 全部变小写 → .lower() 用在最终结果上
# 5. 列表推导式结构：[结果表达式 for 变量 in 原列表 if 筛选条件]

